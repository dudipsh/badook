{
  "name": "@budapest/labeling-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate || true",
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "prisma db push --skip-generate && node dist/main",
    "start:prod": "prisma db push --skip-generate && node dist/main",
    "seed": "bash scripts/deploy-seed.sh",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@budapest/ai-core": "workspace:*",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^6.0.0",
    "archiver": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonrepair": "^3.13.3",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@types/archiver": "^6.0.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
