{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "ocr/prompts/**/*.md",
        "watchAssets": true
      },
      {
        "include": "generated/prisma-client/**/*",
        "watchAssets": false
      }
    ]
  }
}
