# Database
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Authentication
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Encryption (for OAuth tokens - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY="<64-hex-chars>"

# AI Models
OPENAI_API_KEY="sk-proj-..."
GEMINI_API_KEY="AIza..."
GCP_PROJECT_ID="project-id"
GCP_LOCATION="us-central1"
VERTEX_TUNED_MODEL="projects/.../endpoints/..."

# Gmail Integration
GMAIL_CLIENT_ID="...apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="..."
GMAIL_REDIRECT_URI="http://localhost:3001/api/gmail/oauth/callback"
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_EMAIL=""

# Outlook Integration
OUTLOOK_CLIENT_ID="..."
OUTLOOK_CLIENT_SECRET="..."
OUTLOOK_TENANT_ID="..."
OUTLOOK_REDIRECT_URI="http://localhost:3001/api/outlook/oauth/callback"

# Google Cloud Service Account
GOOGLE_APPLICATION_CREDENTIALS="/path/to/gcp-key.json"

# Storage (S3)
S3_REGION="eu-north-1"
S3_BUCKET="bucket-name"
S3_ACCESS_KEY_ID="AKIA..."
S3_SECRET_ACCESS_KEY="..."

# WhatsApp / Twilio
TWILIO_ACCOUNT_SID="..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_NUMBER="+1234567890"

# Server Configuration
PORT=3001
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=20

# Redis
REDIS_URL="redis://localhost:6379"

# Logging & Debugging
SCAN_LOG_VERBOSE=true
DEBUG_MATCHING=false
