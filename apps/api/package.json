{
  "name": "@budapest/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate || true",
    "dev": "prisma generate && prisma migrate dev --name auto && nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "prisma generate && nest build",
    "start": "node dist/src/main",
    "start:prod": "node dist/src/main",
    "start:worker": "node dist/src/worker",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "stop": "lsof -ti:3001 | xargs kill -9 2>/dev/null || echo 'API not running'",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.991.0",
    "@aws-sdk/s3-request-presigner": "^3.991.0",
    "@budapest/ai-core": "workspace:*",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.69.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "googleapis": "^144.0.0",
    "ioredis": "^5.9.3",
    "multer": "^1.4.5-lts.1",
    "mupdf": "^1.27.0",
    "openai": "^4.70.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.0",
    "socket.io": "^4.8.3",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
