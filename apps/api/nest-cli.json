{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "intelligence/prompts/templates/**/*.md",
        "watchAssets": true
      },
      {
        "include": "domain/purchase-orders/fonts/**/*.ttf",
        "watchAssets": false
      }
    ]
  }
}
