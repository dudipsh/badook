# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sagur?schema=public"

# Authentication
JWT_SECRET="generate-a-secure-random-string"
JWT_EXPIRES_IN="7d"

# OpenAI (for OCR and matching)
OPENAI_API_KEY=""

# Google Gemini (alternative AI provider)
GEMINI_API_KEY=""

# Gmail OAuth (for email scanning)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_EMAIL=""
GMAIL_REDIRECT_URI="http://localhost:3001/api/gmail/oauth/callback"

# File Storage (S3-compatible)
S3_BUCKET=""
S3_REGION="eu-north-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="20"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# Redis (optional - enables BullMQ queue)
REDIS_URL=""

# Queue
OCR_CONCURRENCY="2"

# Scan Logging
SCAN_LOG_VERBOSE="true"

# Server
PORT="3001"
NODE_ENV="development"
