{
  "info": {
    "name": "Budapest Matching",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "token",
      "value": "<PASTE_YOUR_JWT_HERE>"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Delete All Matches",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/matching/all",
          "host": ["{{baseUrl}}"],
          "path": ["matching", "all"]
        }
      }
    },
    {
      "name": "2. Run Auto Matching (All)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/matching/auto",
          "host": ["{{baseUrl}}"],
          "path": ["matching", "auto"]
        }
      }
    },
    {
      "name": "2b. Run Auto Matching (by Project)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/matching/auto?projectId=PROJECT_ID_HERE",
          "host": ["{{baseUrl}}"],
          "path": ["matching", "auto"],
          "query": [
            { "key": "projectId", "value": "PROJECT_ID_HERE" }
          ]
        }
      }
    },
    {
      "name": "2c. Run Auto Matching (by Supplier)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/matching/auto?supplierId=SUPPLIER_ID_HERE",
          "host": ["{{baseUrl}}"],
          "path": ["matching", "auto"],
          "query": [
            { "key": "supplierId", "value": "SUPPLIER_ID_HERE" }
          ]
        }
      }
    },
    {
      "name": "2d. Run Auto Matching (by Project + Supplier)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/matching/auto?projectId=PROJECT_ID_HERE&supplierId=SUPPLIER_ID_HERE",
          "host": ["{{baseUrl}}"],
          "path": ["matching", "auto"],
          "query": [
            { "key": "projectId", "value": "PROJECT_ID_HERE" },
            { "key": "supplierId", "value": "SUPPLIER_ID_HERE" }
          ]
        }
      }
    },
    {
      "name": "3. Get All Matches",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/matching?page=1&limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["matching"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "50" }
          ]
        }
      }
    },
    {
      "name": "4. Get Match by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/matching/:id",
          "host": ["{{baseUrl}}"],
          "path": ["matching", ":id"],
          "variable": [
            { "key": "id", "value": "" }
          ]
        }
      }
    }
  ]
}
